# Outside access: https://cam.victoriashome.app
# First visit asks for the username and password once, then sets a 1-year cookie so the phone isn't asked again
# (phones don't re-send the password for live video, which made the sign-in box keep popping up).
# The password hash (caddy-auth) and the cookie secret (caddy.env) live only on the mini PC.
cam.victoriashome.app {
	encode gzip
	# Settings → Sign Out (her request, 2026-10-24: she sometimes looks on someone else's phone): forgets the 1-year
	# sign-in cookie and this site's saved data on that phone; the next visit asks for the username and password again
	handle /signout {
		header Set-Cookie "vh_session=; Path=/; Max-Age=0; Secure; HttpOnly; SameSite=Lax"
		header Clear-Site-Data "\"cookies\", \"storage\", \"cache\""
		header Cache-Control "no-store"
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Signed Out</title><style>body{margin:0;min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;font:17px -apple-system,system-ui,sans-serif;background:#111;color:#eee}a{color:#111;background:#eee;padding:12px 26px;border-radius:999px;text-decoration:none;font-weight:600}</style></head><body><div>Signed Out</div><a href="/">Sign In</a></body></html>` 200
	}
	# Home-screen icon files: the phone fetches these without the sign-in cookie, so they are public
	@public path /icon-180.png /icon-192.png /icon-512.png /manifest.webmanifest
	handle @public {
		reverse_proxy vh-app:80
	}
	# Phone notifications: the alert picture and video, reachable without signing in only through a secret link
	# (VH_NOTIFY, a 32-character key kept in caddy.env on the mini PC). Without that key nothing here is public.
	@notify {
		path_regexp notify ^/n/{$VH_NOTIFY}/(api/events/[A-Za-z0-9.\-]+/(?:snapshot|thumbnail)\.jpg|api/[a-z0-9_]+/latest\.jpg|api/[a-z0-9_]+/start/[0-9.]+/end/[0-9.]+/clip\.mp4)$
		not path /n//*
	}
	handle @notify {
		rewrite * /{re.notify.1}
		reverse_proxy vh-app:80
	}
	@clipwait {
		path_regexp clipwait ^/n/{$VH_NOTIFY}/wait/([a-z0-9_]+/[0-9]+/[0-9]+/(?:clip\.mp4|clip\.gif|sound\.mp4))$
		not path /n//*
	}
	handle @clipwait {
		rewrite * /wait/{re.clipwait.1}
		reverse_proxy clipwait:8000
	}
	@remembered header Cookie *vh_session={$VH_COOKIE}*
	handle @remembered {
		reverse_proxy vh-app:80
	}
	handle {
		route {
			basic_auth {
				import /etc/caddy/auth
			}
			header Set-Cookie "vh_session={$VH_COOKIE}; Path=/; Max-Age=31536000; Secure; HttpOnly; SameSite=Lax"
			reverse_proxy vh-app:80
		}
	}
}

# Frigate's own web page from outside (zones, masks, settings). Frigate asks for its own admin login.
frigate.victoriashome.app {
	encode gzip
	reverse_proxy https://frigate:8971 {
		transport http {
			tls_insecure_skip_verify
		}
	}
}
