# Outside access: https://cam.victoriashome.app
# First visit asks for the username and password once, then sets a 1-year cookie so the phone isn't asked again
# (phones don't re-send the password for live video, which made the sign-in box keep popping up).
# The password hash (caddy-auth) and the cookie secret (caddy.env) live only on the mini PC.
cam.victoriashome.app {
	encode gzip
	@remembered header Cookie *vh_session={$VH_COOKIE}*
	handle @remembered {
		reverse_proxy vh-app:80
	}
	handle {
		route {
			basic_auth {
				import /etc/caddy/auth
			}
			header Set-Cookie "vh_session={$VH_COOKIE}; Path=/; Max-Age=31536000; Secure; HttpOnly; SameSite=Lax"
			reverse_proxy vh-app:80
		}
	}
}
